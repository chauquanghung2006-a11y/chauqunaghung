          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Booking information is correct\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.firstname).to.eql(\"Hung\");\r\n    pm.expect(data.lastname).to.eql(\"Nguyen\");\r\n    pm.expect(data.totalprice).to.eql(150);\r\n    pm.expect(data.depositpaid).to.eql(true);\r\n});\r\n\r\npm.test(\"Booking dates are correct\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.bookingdates.checkin).to.eql(\"2026-11-01\");\r\n    pm.expect(data.bookingdates.checkout).to.eql(\"2026-11-05\");\r\n});"
